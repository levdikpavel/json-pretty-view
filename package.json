{
  "name": "json-pretty-view",
  "displayName": "JSON Pretty View",
  "description": "Read-only pretty view of minified JSON and JSON Lines logs in the same tab, for any file system: local, remote, containers",
  "publisher": "levdikpavel",
  "version": "0.3.1",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/levdikpavel/json-pretty-view.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "json",
    "jsonl",
    "ndjson",
    "log",
    "pretty",
    "viewer",
    "minified",
    "read-only",
    "containers"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "activationEvents": [
    "onFileSystem:jsonpretty"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jsonPretty.toggle",
        "title": "Toggle Pretty View",
        "category": "JSON",
        "icon": "$(list-tree)"
      },
      {
        "command": "jsonPretty.refresh",
        "title": "Refresh Pretty View",
        "category": "JSON",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jsonPretty.toggle",
          "when": "resourceLangId == json || resourceLangId == jsonl || resourceLangId == log || resourceScheme == jsonpretty",
          "group": "navigation"
        },
        {
          "command": "jsonPretty.refresh",
          "when": "resourceScheme == jsonpretty",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "jsonPretty.toggle",
          "when": "resourceLangId == json || resourceLangId == jsonl || resourceLangId == log || resourceScheme == jsonpretty"
        },
        {
          "command": "jsonPretty.refresh",
          "when": "resourceScheme == jsonpretty"
        }
      ]
    }
  }
}
